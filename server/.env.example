# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/acciva-travels

# Long random secret used to sign admin login tokens
JWT_SECRET=change-this-to-a-long-random-string

# Port the API server listens on
PORT=5000

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Used once by `npm run seed` to create the first admin user.
# Change the password after first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-please

# Image uploads (from the admin panel) go here. Free tier at https://cloudinary.com —
# after signing up, these three values are on your dashboard home page.
# REQUIRED once you deploy anywhere other than your own machine: local disk storage
# does not survive a redeploy/restart on Vercel, Render, Railway, etc.
# Leave blank for local development only — uploads will be saved to server/uploads/
# and served from this server, which is fine on localhost but not for production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
